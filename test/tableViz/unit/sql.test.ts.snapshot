exports[`dateCounts 1`] = `
-- :c0 = '\`order_ts\`'
-- :tbl = '\`main\`.\`sales\`.\`orders\`'
SELECT
  CAST(CAST(date_trunc('WEEK', IDENTIFIER(:c0)) AS DATE) AS STRING) AS \`start\`,
  count(*) AS \`n\`
FROM IDENTIFIER(:tbl)
WHERE IDENTIFIER(:c0) IS NOT NULL
GROUP BY 1
ORDER BY 1
`;

exports[`dateCounts 2`] = `
SELECT
  CAST(CAST(date_trunc('MONTH', \`select\`) AS DATE) AS STRING) AS \`start\`,
  count(*) AS \`n\`
FROM \`main\`.\`sales\`.\`orders\` VERSION AS OF 42 TABLESAMPLE (12.5 PERCENT)
WHERE (
  order_date >= '2026-01-01' AND region = 'EMEA'
) AND \`select\` IS NOT NULL
GROUP BY 1
ORDER BY 1
`;

exports[`frequency 1`] = `
-- :c0 = '\`region\`'
-- :tbl = '\`main\`.\`sales\`.\`orders\`'
-- :limit = 21
SELECT \`value\`, \`n\`, sum(\`n\`) OVER () AS \`total\`
FROM (
  SELECT CAST(IDENTIFIER(:c0) AS STRING) AS \`value\`, count(*) AS \`n\`
  FROM IDENTIFIER(:tbl)
  GROUP BY 1
)
ORDER BY CASE WHEN \`value\` IS NULL THEN 0 ELSE 1 END, \`n\` DESC, \`value\`
LIMIT :limit
`;

exports[`frequency 2`] = `
-- :c0 = '\`unit price\`'
-- :tbl = '\`main\`.\`sales\`.\`orders\`'
-- :limit = 51
SELECT \`value\`, \`n\`, sum(\`n\`) OVER () AS \`total\`
FROM (
  SELECT CAST(IDENTIFIER(:c0) AS STRING) AS \`value\`, count(*) AS \`n\`
  FROM IDENTIFIER(:tbl) VERSION AS OF 42 TABLESAMPLE (12.5 PERCENT)
  WHERE (
    order_date >= '2026-01-01' AND region = 'EMEA'
  )
  GROUP BY 1
)
ORDER BY CASE WHEN \`value\` IS NULL THEN 0 ELSE 1 END, \`n\` DESC, \`value\`
LIMIT :limit
`;

exports[`histogram 1`] = `
-- :c0 = '\`amount\`'
-- :lo = 0.5
-- :hi = 5000
-- :bins = 30
-- :tbl = '\`main\`.\`sales\`.\`orders\`'
SELECT
  CASE WHEN CAST(IDENTIFIER(:c0) AS DOUBLE) = :hi THEN :bins ELSE width_bucket(CAST(IDENTIFIER(:c0) AS DOUBLE), :lo, :hi, :bins) END AS \`bucket\`,
  count(*) AS \`n\`
FROM IDENTIFIER(:tbl)
WHERE CAST(IDENTIFIER(:c0) AS DOUBLE) IS NOT NULL
GROUP BY 1
`;

exports[`histogram 2`] = `
-- :c0 = '\`amount\`'
-- :lo = -10
-- :hi = 1e+21
-- :bins = 200
-- :tbl = '\`main\`.\`sales\`.\`orders\`'
SELECT
  CASE WHEN CAST(IDENTIFIER(:c0) AS DOUBLE) = :hi THEN :bins ELSE width_bucket(CAST(IDENTIFIER(:c0) AS DOUBLE), :lo, :hi, :bins) END AS \`bucket\`,
  count(*) AS \`n\`
FROM IDENTIFIER(:tbl) VERSION AS OF 42 TABLESAMPLE (12.5 PERCENT)
WHERE (
  order_date >= '2026-01-01' AND region = 'EMEA'
) AND CAST(IDENTIFIER(:c0) AS DOUBLE) IS NOT NULL
GROUP BY 1
`;

exports[`histogram 3`] = `
-- :lo = 1
-- :hi = 40
-- :bins = 10
SELECT
  CASE WHEN CAST(length(CAST(\`we\`\`ird\` AS STRING)) AS DOUBLE) = :hi THEN :bins ELSE width_bucket(CAST(length(CAST(\`we\`\`ird\` AS STRING)) AS DOUBLE), :lo, :hi, :bins) END AS \`bucket\`,
  count(*) AS \`n\`
FROM \`główny\`.\`sales data\`.\`select\`\`from\`
WHERE CAST(length(CAST(\`we\`\`ird\` AS STRING)) AS DOUBLE) IS NOT NULL
GROUP BY 1
`;

exports[`numericStats 1`] = `
-- :c0 = '\`amount\`'
-- :tbl = '\`main\`.\`sales\`.\`orders\`'
SELECT \`n\`, \`nn\`, \`zeros\`, \`negatives\`, \`min\`, \`max\`, \`mean\`, \`stddev\`, \`p\`[0] AS \`p0\`, \`p\`[1] AS \`p1\`, \`p\`[2] AS \`p2\`, \`p\`[3] AS \`p3\`, \`p\`[4] AS \`p4\`, \`p\`[5] AS \`p5\`, \`p\`[6] AS \`p6\`
FROM (
  SELECT
    count(*) AS \`n\`,
    count(IDENTIFIER(:c0)) AS \`nn\`,
    count_if(IDENTIFIER(:c0) = 0) AS \`zeros\`,
    count_if(IDENTIFIER(:c0) < 0) AS \`negatives\`,
    CAST(min(IDENTIFIER(:c0)) AS STRING) AS \`min\`,
    CAST(max(IDENTIFIER(:c0)) AS STRING) AS \`max\`,
    avg(CAST(IDENTIFIER(:c0) AS DOUBLE)) AS \`mean\`,
    stddev(CAST(IDENTIFIER(:c0) AS DOUBLE)) AS \`stddev\`,
    approx_percentile(CAST(IDENTIFIER(:c0) AS DOUBLE), array(0.01, 0.05, 0.25, 0.5, 0.75, 0.95, 0.99)) AS \`p\`
  FROM IDENTIFIER(:tbl)
)
`;

