)
`;

exports[`numericStats 3`] = `
-- :c0 = '\`we\`\`ird\`'
-- :tbl = '\`główny\`.\`sales data\`.\`select\`\`from\`'
SELECT \`n\`, \`nn\`, \`zeros\`, \`negatives\`, \`min\`, \`max\`, \`mean\`, \`stddev\`, \`p\`[0] AS \`p0\`, \`p\`[1] AS \`p1\`, \`p\`[2] AS \`p2\`, \`p\`[3] AS \`p3\`, \`p\`[4] AS \`p4\`, \`p\`[5] AS \`p5\`, \`p\`[6] AS \`p6\`
FROM (
  SELECT
    count(*) AS \`n\`,
    count(length(CAST(IDENTIFIER(:c0) AS STRING))) AS \`nn\`,
    count_if(length(CAST(IDENTIFIER(:c0) AS STRING)) = 0) AS \`zeros\`,
    count_if(length(CAST(IDENTIFIER(:c0) AS STRING)) < 0) AS \`negatives\`,
    CAST(min(length(CAST(IDENTIFIER(:c0) AS STRING))) AS STRING) AS \`min\`,
    CAST(max(length(CAST(IDENTIFIER(:c0) AS STRING))) AS STRING) AS \`max\`,
    avg(CAST(length(CAST(IDENTIFIER(:c0) AS STRING)) AS DOUBLE)) AS \`mean\`,
    stddev(CAST(length(CAST(IDENTIFIER(:c0) AS STRING)) AS DOUBLE)) AS \`stddev\`,
    approx_percentile(CAST(length(CAST(IDENTIFIER(:c0) AS STRING)) AS DOUBLE), array(0.01, 0.05, 0.25, 0.5, 0.75, 0.95, 0.99)) AS \`p\`
  FROM IDENTIFIER(:tbl)
)
`;

exports[`overview: difficult names 1`] = `
-- :c0 = '\`unit price\`'
-- :c1 = '\`we\`\`ird\`'
-- :c2 = '\`zamówienie\`'
-- :c3 = '\`select\`'
-- :tbl = '\`główny\`.\`sales data\`.\`select\`\`from\`'
SELECT
  count(*) AS \`n\`,
  count(IDENTIFIER(:c0)) AS \`c0_nn\`,
  approx_count_distinct(IDENTIFIER(:c0)) AS \`c0_d\`,
  CAST(min(IDENTIFIER(:c0)) AS STRING) AS \`c0_min\`,
  CAST(max(IDENTIFIER(:c0)) AS STRING) AS \`c0_max\`,
  avg(CAST(IDENTIFIER(:c0) AS DOUBLE)) AS \`c0_avg\`,
  count(IDENTIFIER(:c1)) AS \`c1_nn\`,
  approx_count_distinct(IDENTIFIER(:c1)) AS \`c1_d\`,
  count(IDENTIFIER(:c2)) AS \`c2_nn\`,
  approx_count_distinct(IDENTIFIER(:c2)) AS \`c2_d\`,
  CAST(min(IDENTIFIER(:c2)) AS STRING) AS \`c2_min\`,
  CAST(max(IDENTIFIER(:c2)) AS STRING) AS \`c2_max\`,
  avg(CAST(IDENTIFIER(:c2) AS DOUBLE)) AS \`c2_avg\`,
  count(IDENTIFIER(:c3)) AS \`c3_nn\`,
  approx_count_distinct(IDENTIFIER(:c3)) AS \`c3_d\`,
  CAST(min(IDENTIFIER(:c3)) AS STRING) AS \`c3_min\`,
  CAST(max(IDENTIFIER(:c3)) AS STRING) AS \`c3_max\`
FROM IDENTIFIER(:tbl)
`;

