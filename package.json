{
  "name": "dbx-notebook",
  "displayName": "Databricks Source Notebooks",
  "description": "Open Databricks .py source notebooks in the native notebook UI and run cells on a cluster.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks"
  ],
  "main": "./extension.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p src/tableViz/tsconfig.core.json && tsc -p src/tableViz/tsconfig.host.json && tsc -p src/tableViz/tsconfig.webview.json && tsc -p test/tableViz/tsconfig.json",
    "test:unit": "npm run build && node test/format.test.js && node test/client.test.js && LC_ALL=en_US.UTF-8 node --test \"test/tableViz/unit/*.test.ts\" \"dist/test/*.test.cjs\"",
    "test:e2e": "npm run build && test/run-e2e.sh",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "package": "npm run build && python3 scripts/package.py",
    "test:live": "node --test --test-concurrency=1 \"test/tableViz/live/*.test.ts\"",
    "live:setup": "node test/tableViz/live/setup.ts",
    "test:vsix": "npm run package && test/run-vsix.sh"
  },
  "activationEvents": [
    "onLanguage:python",
    "onWebviewPanel:dbxNotebook.tableViz.board"
  ],
  "contributes": {
    "notebooks": [
      {
        "type": "dbx-notebook",
        "displayName": "Databricks Source Notebook",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.py"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dbxNotebook.openAsNotebook",
        "title": "Open as Databricks Notebook",
        "category": "Databricks Notebook",
        "icon": "$(notebook)"
      },
      {
        "command": "dbxNotebook.selectCluster",
        "title": "Select Cluster",
        "category": "Databricks Notebook",
        "icon": "$(server)"
      },
      {
        "command": "dbxNotebook.resetContext",
        "title": "Reset Execution Context (Clear State)",
        "category": "Databricks Notebook",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dbxNotebook.tableViz.visualizeTable",
        "title": "Visualize Table",
        "category": "Databricks Notebook"
      },
      {
        "command": "dbxNotebook.tableViz.visualizeTableUnderCursor",
        "title": "Visualize Table Under Cursor",
        "category": "Databricks Notebook"
      },
      {
        "command": "dbxNotebook.tableViz.selectCompute",
        "title": "Select Profile and Compute for Tables",
        "category": "Databricks Notebook"
      },
      {
        "command": "dbxNotebook.tableViz.refreshTables",
        "title": "Refresh Tables",
        "category": "Databricks Notebook",
        "icon": "$(refresh)"
      },
      {
        "command": "dbxNotebook.tableViz.visualizeNode",
        "title": "Visualize",
        "category": "Databricks Notebook",
        "icon": "$(graph)"
      },
      {
        "command": "dbxNotebook.tableViz.addFavorite",
        "title": "Add to Favorites",
        "category": "Databricks Notebook",
        "icon": "$(star-empty)"
      },
      {
        "command": "dbxNotebook.tableViz.removeFavorite",
        "title": "Remove from Favorites",
        "category": "Databricks Notebook",
        "icon": "$(star-full)"
      },
      {
        "command": "dbxNotebook.tableViz.compareTables",
        "title": "Compare Tables",
        "category": "Databricks Notebook",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dbxNotebook.openAsNotebook",
          "when": "resourceExtname == .py && !notebookType && !isInDiffEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dbxNotebook.openAsNotebook",
          "when": "resourceExtname == .py",
          "group": "navigation@90"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "dbxNotebook.selectCluster",
          "when": "notebookType == dbx-notebook",
          "group": "navigation/execute@10"
        },
        {
          "command": "dbxNotebook.resetContext",
          "when": "notebookType == dbx-notebook",
          "group": "navigation/execute@11"
        }
      ],
      "commandPalette": [
        {
          "command": "dbxNotebook.resetContext",
          "when": "notebookType == dbx-notebook"
        },
        {
          "command": "dbxNotebook.tableViz.visualizeNode",
          "when": "false"
        },
        {
          "command": "dbxNotebook.tableViz.addFavorite",
          "when": "false"
        },
        {
          "command": "dbxNotebook.tableViz.removeFavorite",
          "when": "false"
        },
        {
          "command": "dbxNotebook.tableViz.visualizeTableUnderCursor",
          "when": "editorLangId == sql || editorLangId == python"
        }
      ],
      "view/title": [
        {
          "command": "dbxNotebook.tableViz.refreshTables",
          "when": "view == dbxNotebook.tableViz.tables",
          "group": "navigation@1"
        },
        {
          "command": "dbxNotebook.tableViz.selectCompute",
          "when": "view == dbxNotebook.tableViz.tables",
          "group": "1_connection"
        },
        {
          "command": "dbxNotebook.tableViz.visualizeTable",
          "when": "view == dbxNotebook.tableViz.tables",
          "group": "1_connection"
        }
      ],
      "view/item/context": [
        {
          "command": "dbxNotebook.tableViz.visualizeNode",
          "when": "view == dbxNotebook.tableViz.tables && viewItem =~ /^tableViz\\.(table|favorite)$/",
          "group": "inline@1"
        },
        {
          "command": "dbxNotebook.tableViz.addFavorite",
          "when": "view == dbxNotebook.tableViz.tables && viewItem == tableViz.table",
          "group": "inline@2"
        },
        {
          "command": "dbxNotebook.tableViz.removeFavorite",
          "when": "view == dbxNotebook.tableViz.tables && viewItem == tableViz.favorite",
          "group": "inline@2"
        },
        {
          "command": "dbxNotebook.tableViz.visualizeNode",
          "when": "view == dbxNotebook.tableViz.tables && viewItem =~ /^tableViz\\.(table|favorite)$/",
          "group": "1_table@1"
        },
        {
          "command": "dbxNotebook.tableViz.compareTables",
          "when": "view == dbxNotebook.tableViz.tables && viewItem =~ /^tableViz\\.(table|favorite)$/",
          "group": "inline@3"
        },
        {
          "command": "dbxNotebook.tableViz.compareTables",
          "when": "view == dbxNotebook.tableViz.tables && viewItem =~ /^tableViz\\.(table|favorite)$/",
          "group": "1_table@2"
        }
      ],
      "editor/context": [
        {
          "command": "dbxNotebook.tableViz.visualizeTableUnderCursor",
          "when": "editorLangId == sql || (editorLangId == python && !notebookEditorFocused)",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "Databricks Source Notebooks",
      "properties": {
        "dbxNotebook.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open .py files that start with '# Databricks notebook source' in the notebook UI automatically."
        },
        "dbxNotebook.host": {
          "type": "string",
          "default": "",
          "description": "Databricks workspace URL. Leave empty to use DATABRICKS_HOST, the Databricks extension's project settings, or ~/.databrickscfg."
        },
        "dbxNotebook.profile": {
          "type": "string",
          "default": "",
          "description": "Profile in ~/.databrickscfg to read the host and token from. Defaults to DATABRICKS_CONFIG_PROFILE, then DEFAULT."
        },
        "dbxNotebook.clusterId": {
          "type": "string",
          "default": "",
          "description": "Cluster that runs notebook cells. Leave empty to choose with 'Databricks Notebook: Select Cluster'."
        },
        "dbxNotebook.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Databricks CLI, used for OAuth login when no token is configured. Defaults to the CLI bundled with the Databricks extension, then 'databricks' on PATH."
        },
        "dbxNotebook.tableViz.defaultBins": {
          "type": "integer",
          "default": 30,
          "minimum": 5,
          "maximum": 200,
          "markdownDescription": "The number of bins of a new histogram in \"Visualize Table\". You can change the number on each card."
        },
        "dbxNotebook.tableViz.topValues": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "The number of values in the bar chart of a category column in \"Visualize Table\". The chart shows the other values as one bar, \"Other\"."
        },
        "dbxNotebook.tableViz.warehouseId": {
          "type": "string",
          "default": "",
          "markdownDescription": "The ID of the SQL warehouse that runs the queries of \"Visualize Table\". A warehouse or a cluster that you select with \"Select Profile and Compute for Tables\" is used before this setting."
        },
        "dbxNotebook.tableViz.confirmComputeStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before a query starts a stopped SQL warehouse or cluster. Compute that runs costs money, and a cluster can take several minutes to start."
        },
        "dbxNotebook.tableViz.maxConcurrentQueries": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 20,
          "markdownDescription": "The largest number of queries that \"Visualize Table\" runs at the same time. The other queries wait. `0` means automatic: 4 on a SQL warehouse and 2 on a cluster, because notebooks and jobs use a cluster at the same time."
        },
        "dbxNotebook.tableViz.queryTimeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 10,
          "markdownDescription": "The time limit of one query of \"Visualize Table\", in seconds. The extension cancels a query that runs longer."
        },
        "dbxNotebook.tableViz.largeTableWarningGB": {
          "type": "number",
          "default": 100,
          "minimum": 0.001,
          "markdownDescription": "\"Visualize Table\" asks before the first full scan of a table that is larger than this size, in GB."
        },
        "dbxNotebook.tableViz.matchColumnsCaseSensitive": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When you compare two tables, match the column `Region` only with `Region`. If this is off, `Region` also matches `region`."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "dbxNotebook.tableViz.tables",
          "name": "Databricks Tables",
          "visibility": "collapsed",
          "contextualTitle": "Databricks Tables"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "dbxNotebook.tableViz.view",
        "displayName": "Table Visualization",
        "selector": [
          {
            "filenamePattern": "*.tableviz.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "dependencies": {
    "@databricks/sql": "3.0.0",
    "@vscode/codicons": "0.0.46-24",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
